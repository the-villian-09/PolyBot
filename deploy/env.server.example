NODE_ENV=production
TZ=UTC
APP_NAME=polybot
APP_MODE=dry-run
LOG_LEVEL=info
POLYMARKET_API_BASE_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=
POLYGON_CHAIN_ID=137
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_RPC_FALLBACK_URL=
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
SCAN_INTERVAL_MS=5000
MARKET_FRESHNESS_MS=3000
DRY_RUN_MARKET_LIMIT=50
BOOK_FETCH_CONCURRENCY=5
MIN_BOOK_BID_PRICE=0.05
MAX_BOOK_ASK_PRICE=0.95
MAX_MIRROR_GAP=0.05
MIN_GROUP_EDGE=0.005
MIN_GROUP_BID_LIQUIDITY=0.001
ARBITRAGE_MAX_TOTAL_PRICE=0.97
MIN_EDGE=0.012
MAX_SPREAD=0.02
MIN_LIQUIDITY_MULTIPLIER=2
MAX_BALANCE_FRACTION_PER_TRADE=0.10
MAX_TRADE_SIZE_USD=50
MAX_LIQUIDITY_FRACTION=0.80
FILL_TIMEOUT_MS=1500
MARKET_COOLDOWN_MS=10000
DAILY_STOP_LOSS_USD=50
MAX_TOTAL_CAPITAL_USD=500
MAX_PER_MARKET_EXPOSURE_USD=50
TRADING_ENABLED=false
ALLOW_LIVE_TRADING=false
RECONCILE_ON_STARTUP=true
RECONCILE_INTERVAL_MS=10000
DB_PATH=./data/polyedge.sqlite
LOG_FORMAT=json
LOG_TRADES=true
LOG_OPPORTUNITY_SKIPS=true
